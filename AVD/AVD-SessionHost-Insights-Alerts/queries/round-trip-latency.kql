// AVD-Insights-RoundTripLatency
// Detects session hosts where RemoteFX Network TCP round-trip time exceeds {maxRoundTripMs} ms.
// Counter: \RemoteFX Network(*)\Current TCP RTT
// Source table: Perf (via DCR Microsoft-Perf stream)
// Thresholds — edit these values or override at deployment time
let _maxRoundTripMs  = 150;
let _minSampleCount  = 3;
Perf
| where TimeGenerated > ago(15m)
| where ObjectName == "RemoteFX Network"
    and CounterName == "Current TCP RTT"
| summarize
    AvgRttMs     = avg(CounterValue),
    MaxRttMs     = max(CounterValue),
    SampleCount  = count()
    by Computer
| where SampleCount >= _minSampleCount
    and AvgRttMs > _maxRoundTripMs
| project
    Computer,
    AvgRttMs      = round(AvgRttMs, 1),
    MaxRttMs      = round(MaxRttMs, 1),
    SampleCount
| order by AvgRttMs desc
