// AVD-Insights-Category-CorrelatedSignals
// Consolidated category alert: fires when multi-signal correlation patterns are detected.
// Signals: Correlated Hosts (CPU+Memory+Disk), FSLogix+Perf Correlation
// Source tables: Perf, WVDCheckpoints
// Thresholds — edit these values or override at deployment time
let _maxCpuPercent          = 90;
let _minAvailableMemoryMB   = 512;
let _maxDiskLatencySeconds  = 0.025;
let _minSignalCount         = 2;
let _maxProfileLoadMs       = 30000;
let _fslogixMaxCpu          = 85;
let _window = 15m;
let _fslogixWindow = 30m;
// --- CorrelatedHosts: multiple resource signals breaching simultaneously ---
let cpuHigh = Perf
| where TimeGenerated > ago(_window)
| where ObjectName == "Processor Information" and InstanceName == "_Total" and CounterName == "% Processor Time"
| summarize AvgCpu = avg(CounterValue) by Computer
| where AvgCpu > _maxCpuPercent
| project Computer, Signal = "CPU", Value = strcat(round(AvgCpu, 1), "%");
let memLow = Perf
| where TimeGenerated > ago(_window)
| where ObjectName == "Memory" and CounterName == "Available MBytes"
| summarize AvgMem = avg(CounterValue) by Computer
| where AvgMem < _minAvailableMemoryMB
| project Computer, Signal = "Memory", Value = strcat(round(AvgMem, 0), " MB");
let diskSlow = Perf
| where TimeGenerated > ago(_window)
| where ObjectName == "LogicalDisk" and CounterName in ("Avg. Disk sec/Read", "Avg. Disk sec/Write") and InstanceName != "_Total"
| summarize AvgLatency = avg(CounterValue) by Computer
| where AvgLatency > _maxDiskLatencySeconds
| project Computer, Signal = "Disk", Value = strcat(round(AvgLatency * 1000, 1), " ms");
let correlatedHosts = union cpuHigh, memLow, diskSlow
| summarize Signals = make_set(Signal), Details = make_set(strcat(Signal, "=", Value)), SignalCount = dcount(Signal) by Computer
| where SignalCount >= _minSignalCount
| project Computer, Signal = strcat("CorrelatedHosts(", strcat_array(Signals, "+"), ")"),
    AvgValue = todouble(SignalCount),
    MaxValue = todouble(SignalCount),
    SampleCount = 1;
// --- FSLogixCorrelation: slow profiles + degraded host performance ---
let profileSlow = WVDCheckpoints
| where TimeGenerated > ago(_fslogixWindow)
| where Name in ("OnAttach", "LoadProfile", "OnDetach")
| extend DurationMs = toint(Parameters.DurationMs)
| where isnotnull(DurationMs) and DurationMs > _maxProfileLoadMs
| summarize AvgProfileMs = avg(DurationMs), MaxProfileMs = max(DurationMs), ProfileOps = count()
    by SessionHostName = tostring(Parameters.SessionHostName);
let hostPerf = Perf
| where TimeGenerated > ago(_fslogixWindow)
| where (ObjectName == "Processor Information" and InstanceName == "_Total" and CounterName == "% Processor Time")
    or  (ObjectName == "LogicalDisk" and CounterName in ("Avg. Disk sec/Read", "Avg. Disk sec/Write") and InstanceName != "_Total")
| extend IsCpu = (ObjectName == "Processor Information"), IsDisk = (ObjectName == "LogicalDisk")
| summarize AvgCpu = avgif(CounterValue, IsCpu), AvgDiskLatency = avgif(CounterValue, IsDisk)
    by Computer;
let fslogixCorrelation = profileSlow
| join kind=inner hostPerf on $left.SessionHostName == $right.Computer
| where AvgCpu > _fslogixMaxCpu or AvgDiskLatency > _maxDiskLatencySeconds
| project Computer, Signal = "FSLogixCorrelation",
    AvgValue = round(AvgProfileMs / 1000.0, 1),
    MaxValue = round(MaxProfileMs / 1000.0, 1),
    SampleCount = ProfileOps;
union correlatedHosts, fslogixCorrelation
| order by Computer asc, Signal asc
