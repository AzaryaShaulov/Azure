{
  "schemaVersion": "1.0",
  "description": "Maps Microsoft Learn VM lifecycle series names (normalized: lower-case, '-series' removed) to exact Azure VM size name patterns. Patterns follow the size lists on the Microsoft Learn size-series pages. A Learn series name that is not listed here is reported as 'Unable to Confirm' and surfaced as an unmapped-series warning - it is never guessed.",
  "sourceBasis": [
    "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions",
    "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/end-of-life-sizes-list",
    "https://learn.microsoft.com/azure/virtual-machines/sizes/lifecycle/retirement/retired-sizes-modernization-guide",
    "https://learn.microsoft.com/azure/virtual-machines/vm-naming-conventions",
    "https://github.com/MicrosoftDocs/azure-compute-docs (size tables for retired confidential series, e.g. ECas_cc_v5)"
  ],
  "series": [
    { "key": "d",             "aliases": ["standard d", "dv1", "memory-optimized d"], "patterns": ["^Standard_D(1|2|3|4|11|12|13|14)$"] },
    { "key": "ds",            "aliases": ["dsv1", "memory-optimized ds"],          "patterns": ["^Standard_DS(1|2|3|4|11|12|13|14)$"] },
    { "key": "dv2",           "aliases": [],                                        "patterns": ["^Standard_D(1|2|3|4|5|11|12|13|14|15)_v2(_Promo)?$"] },
    { "key": "dsv2",          "aliases": [],                                        "patterns": ["^Standard_DS(1|2|3|4|5|11|12|13|14|15)(-\\d+)?_v2(_Promo)?$"] },
    { "key": "av2",           "aliases": ["av2/amv2", "amv2"],                      "patterns": ["^Standard_A(1|2|4|8)m?_v2$"] },
    { "key": "b v1",          "aliases": ["bv1", "b"],                              "patterns": ["^Standard_B\\d+(ls|s|ms)$"] },
    { "key": "f",             "aliases": [],                                        "patterns": ["^Standard_F(1|2|4|8|16)$"] },
    { "key": "fs",            "aliases": [],                                        "patterns": ["^Standard_F(1|2|4|8|16)s$"] },
    { "key": "fsv2",          "aliases": [],                                        "patterns": ["^Standard_F(2|4|8|16|32|48|64|72)s_v2$"] },
    { "key": "g",             "aliases": [],                                        "patterns": ["^Standard_G[1-5]$"] },
    { "key": "gs",            "aliases": [],                                        "patterns": ["^Standard_GS[1-5](-\\d+)?$"] },
    { "key": "ls",            "aliases": ["lsv1"],                                  "patterns": ["^Standard_L(4|8|16|32)s$"] },
    { "key": "lsv2",          "aliases": [],                                        "patterns": ["^Standard_L(8|16|32|48|64|80)s_v2$"] },
    { "key": "ncv3-nc24rs",   "aliases": [],                                        "patterns": ["^Standard_NC24rs_v3$"] },
    { "key": "ncv3",          "aliases": [],                                        "patterns": ["^Standard_NC(6|12|24)s_v3$"] },
    { "key": "nvv3",          "aliases": [],                                        "patterns": ["^Standard_NV(12|24|48)s_v3$"] },
    { "key": "nvv4",          "aliases": [],                                        "patterns": ["^Standard_NV(4|8|16|32)as_v4$"] },
    { "key": "np",            "aliases": ["np (standard_np10s standard_np20s standard_np40s)"], "patterns": ["^Standard_NP(10|20|40)s$"] },
    { "key": "hbv2",          "aliases": [],                                        "patterns": ["^Standard_HB120(-\\d+)?rs_v2$"] },
    { "key": "hc",            "aliases": [],                                        "patterns": ["^Standard_HC44(-(16|32))?rs$"] },
    { "key": "preview dc",    "aliases": ["dc"],                                    "patterns": ["^Standard_DC(2|4)s$"] },
    { "key": "dcsv2",         "aliases": [],                                        "patterns": ["^Standard_DC(1|2|4)s_v2$", "^Standard_DC8_v2$"] },
    { "key": "dcsv3",         "aliases": [],                                        "patterns": ["^Standard_DC(1|2|4|8|16|24|32|48)s_v3$"] },
    { "key": "dcdsv3",        "aliases": [],                                        "patterns": ["^Standard_DC(1|2|4|8|16|24|32|48)ds_v3$"] },
    { "key": "dcasccv5",      "aliases": [],                                        "patterns": ["^Standard_DC(4|8|16|32|48|64|96)as_cc_v5$"] },
    { "key": "dcadsccv5",     "aliases": [],                                        "patterns": ["^Standard_DC(4|8|16|32|48|64|96)ads_cc_v5$"] },
    { "key": "ecasccv5",      "aliases": [],                                        "patterns": ["^Standard_EC(4|8|16|20|32|48|64|96)as_cc_v5$"] },
    { "key": "ecadsccv5",     "aliases": [],                                        "patterns": ["^Standard_EC(4|8|16|20|32|48|64|96)ads_cc_v5$"] },
    { "key": "dv3",           "aliases": [],                                        "patterns": ["^Standard_D(2|4|8|16|32|48|64)_v3$"] },
    { "key": "dsv3",          "aliases": [],                                        "patterns": ["^Standard_D(2|4|8|16|32|48|64)s_v3$"] },
    { "key": "ev3",           "aliases": [],                                        "patterns": ["^Standard_E\\d+i?_v3$"] },
    { "key": "esv3",          "aliases": [],                                        "patterns": ["^Standard_E\\d+(-\\d+)?i?s_v3$"] },
    { "key": "ev4",           "aliases": [],                                        "patterns": ["^Standard_E\\d+i?_v4$"] },
    { "key": "esv4",          "aliases": [],                                        "patterns": ["^Standard_E\\d+(-\\d+)?i?s_v4$"] },
    { "key": "eav4",          "aliases": [],                                        "patterns": ["^Standard_E\\d+a_v4$"] },
    { "key": "easv4",         "aliases": [],                                        "patterns": ["^Standard_E\\d+(-\\d+)?as_v4$"] },
    { "key": "edv4",          "aliases": [],                                        "patterns": ["^Standard_E\\d+i?d_v4$"] },
    { "key": "edsv4",         "aliases": [],                                        "patterns": ["^Standard_E\\d+(-\\d+)?i?ds_v4$"] }
  ],
  "compositeNames": {
    "dv1 and dsv1": ["d", "ds"],
    "dv2 and dsv2": ["dv2", "dsv2"],
    "dv3 and dsv3": ["dv3", "dsv3"],
    "av2 and amv2": ["av2"],
    "ev3 and esv3": ["ev3", "esv3"],
    "ev4 and esv4": ["ev4", "esv4"],
    "eav4 and easv4": ["eav4", "easv4"],
    "edv4 and edsv4": ["edv4", "edsv4"],
    "av2/amv2": ["av2"],
    "dcsv3/dcdsv3": ["dcsv3", "dcdsv3"],
    "dcsv3 and dcdsv3": ["dcsv3", "dcdsv3"],
    "dcas_cc_v5/dcads_cc_v5": ["dcasccv5", "dcadsccv5"],
    "ecas_cc_v5/ecads_cc_v5": ["ecasccv5", "ecadsccv5"],
    "msv2 and mdsv2 isolated sizes": ["standard_m192is_v2", "standard_m192ims_v2", "standard_m192ids_v2", "standard_m192idms_v2"]
  },
  "nonVmSizeCategories": ["ADH"],
  "nonVmSizeCategoriesNote": "Retired-list sections whose rows are not VM sizes (ADH = Azure Dedicated Host SKUs such as Dsv3-Type1). They are reported as lifecycle context, never mapped to VM size patterns."
}
