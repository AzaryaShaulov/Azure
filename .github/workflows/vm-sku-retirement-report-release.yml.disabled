# Retired historical workflow. The .disabled extension prevents GitHub Actions from running it.
# Maintained project: https://github.com/AzaryaShaulov/VMSKURetirementReport/
name: VMSKURetirementReport Release

# The tool is supported on Windows only (Azure CLI and local PowerShell, as a GitHub Copilot skill or a standalone script),
# so the release is built and published from a Windows runner.
#
# The tag carries the project name, so a tag for another component of this repository never starts this workflow:
#   git tag vm-sku-retirement-report-v1.2.3 && git push origin vm-sku-retirement-report-v1.2.3

on:
  push:
    tags: ['vm-sku-retirement-report-v*.*.*']

permissions:
  contents: read

jobs:
  build:
    name: Build release artifacts
    runs-on: windows-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Verify tag matches tool version
        shell: pwsh
        working-directory: Assessments/VMSKURetirementReport
        env:
          TAG: ${{ github.ref_name }}
        run: |
          Import-Module ./skills/vm-sku-retirement-report/scripts/modules/Common.psm1 -Force -DisableNameChecking
          $v = Get-ToolVersion
          if ("vm-sku-retirement-report-v$v" -ne $env:TAG) { throw "Tag $env:TAG does not match tool version v$v (expected vm-sku-retirement-report-v$v)" }

      - name: Lint, test, package
        shell: pwsh
        working-directory: Assessments/VMSKURetirementReport
        run: ./build.ps1 -Task Bootstrap, Lint, Version, Test, Package -CI

      - name: Upload release artifacts
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-artifacts
          path: |
            Assessments/VMSKURetirementReport/dist/*.zip
            Assessments/VMSKURetirementReport/dist/*.zip.sha256

  release:
    name: Publish release
    runs-on: windows-latest
    needs: build
    permissions:
      contents: write
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Download release artifacts
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-artifacts
          path: Assessments/VMSKURetirementReport/dist

      - name: Create GitHub release
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        shell: pwsh
        working-directory: Assessments/VMSKURetirementReport
        run: |
          $ver = $env:TAG -replace '^vm-sku-retirement-report-v', ''
          $section = [regex]::Match((Get-Content CHANGELOG.md -Raw), "(?ms)^## \[$([regex]::Escape($ver))\].*?(?=^## \[|\z)").Value
          if (-not $section) { $section = 'See CHANGELOG.md' }
          Set-Content -Path release-notes.md -Value $section
          $zip = "dist/VMSKURetirementReport-v$ver.zip"
          gh release create $env:TAG $zip "$zip.sha256" --title "Azure VM SKU Retirement Report v$ver" --notes-file release-notes.md --verify-tag
